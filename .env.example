# FARMSAGE_API_KEY: Gemini API key for smart agronomy advisory and hardware telemetry authentication.
# Obtain your Gemini API key from https://aistudio.google.com/app/apikey
FARMSAGE_API_KEY="your_api_key_here"

# GEMINI_API_KEY: Standard Gemini API key (injected automatically in Google AI Studio).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Optional host URL for self-referential links.
APP_URL="http://localhost:3000"

